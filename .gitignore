# Local .terraform directories
**/.terraform/*

# .tfstate files containing architectural secrets & raw state data
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include hcl lock files (Recommended to keep track of provider versions)
!.terraform.lock.hcl

# Exclude local variable definitions (where you might accidentally type passwords)
*.tfvars
*.tfvars.json
